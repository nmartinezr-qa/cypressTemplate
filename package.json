{
  "name": "CypressTemplate",
  "version": "1.0.0",
  "description": "Tests de Cypress para CypressTemplate",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"cypress/**/*.{js,jsx,ts,tsx}\"",
    "check-code": "npm run format:check && npm run lint",
    "fix-code": "npm run format && npm run lint:fix",
    "test:smoke": "cypress run --env grep=smoke",
    "test:regression": "cypress run --env grep=regression",
    "test:api": "cypress run --env grep=api"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "Norvin Martinez",
  "license": "ISC",
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "devDependencies": {
    "cypress": "^14.2.1",
    "cypress-grep": "^3.0.4",
    "cypress-mochawesome-reporter": "^3.8.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-naming-convention": "^0.1.3",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "winston": "^3.17.0"
  }
}